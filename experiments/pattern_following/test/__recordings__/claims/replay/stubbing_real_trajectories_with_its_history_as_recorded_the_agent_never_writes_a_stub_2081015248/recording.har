ditionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"Get all credit card accounts for a user.\\n\\nReturns information about each credit card account including card type,\\ndate opened, current balance, and reward points.\",\n      \"name\": \"get_credit_card_accounts_by_user\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"properties\": {\n          \"user_id\": {\n            \"description\": \"The ID of the user to look up credit card accounts for\",\n            \"title\": \"User Id\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"user_id\"\n        ],\n        \"title\": \"parameters\",\n        \"type\": \"object\",\n        \"additionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"Log a verification record after successfully verifying a user's identity.\\n\\nCall this tool after you have verified a user by confirming 2 out of 4 identity fields\\n(date of birth, email, phone number, address). This creates an audit record of the verification.\",\n      \"name\": \"log_verification\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"properties\": {\n          \"address\": {\n            \"description\": \"The verified user's address\",\n            \"title\": \"Address\",\n            \"type\": \"string\"\n          },\n          \"date_of_birth\": {\n            \"description\": \"The verified user's date of birth (MM/DD/YYYY format)\",\n            \"title\": \"Date Of Birth\",\n            \"type\": \"string\"\n          },\n          \"email\": {\n            \"description\": \"The verified user's email\",\n            \"title\": \"Email\",\n            \"type\": \"string\"\n          },\n          \"name\": {\n            \"description\": \"The verified user's full name\",\n            \"title\": \"Name\",\n            \"type\": \"string\"\n          },\n          \"phone_number\": {\n            \"description\": \"The verified user's phone number\",\n            \"title\": \"Phone Number\",\n            \"type\": \"string\"\n          },\n          \"time_verified\": {\n            \"description\": \"The timestamp of the verification (e.g., \\\"2025-11-14 03:40:00 EST\\\")\",\n            \"title\": \"Time Verified\",\n            \"type\": \"string\"\n          },\n          \"user_id\": {\n            \"description\": \"The verified user's ID\",\n            \"title\": \"User Id\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"address\",\n          \"date_of_birth\",\n          \"email\",\n          \"name\",\n          \"phone_number\",\n          \"time_verified\",\n          \"user_id\"\n        ],\n        \"title\": \"parameters\",\n        \"type\": \"object\",\n        \"additionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"Pass a tool to the user so they can execute it themselves.\\n\\nUse this when the knowledge base indicates that the user should perform\\nan action themselves (e.g., \\\"to do X, have the user call tool_name(args)\\\").\\n\\nThe user will then be able to call `call_discoverable_tool` with the same\\ntool name and arguments to simulate executing the action.\",\n      \"name\": \"give_discoverable_user_tool\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"properties\": {\n          \"arguments\": {\n            \"default\": \"{}\",\n            \"description\": \"JSON string of arguments for the tool (e.g., '{\\\"url\\\": \\\"https://example.com\\\"}')\",\n            \"title\": \"Arguments\",\n            \"type\": \"string\"\n          },\n          \"discoverable_tool_name\": {\n            \"description\": \"The name of the discoverable tool (e.g., \\\"open_webpage\\\", \\\"navigate_to_section\\\")\",\n            \"title\": \"Discoverable Tool Name\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"arguments\",\n          \"discoverable_tool_name\"\n        ],\n        \"title\": \"parameters\",\n        \"type\": \"object\",\n        \"additionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"Unlock an agent discoverable tool that was found in the knowledge base.\\n\\nUse this when the knowledge base indicates that you have access to a specialized\\ninternal tool. The knowledge base will tell you the tool name to unlock.\\n\\nAfter unlocking, you can use the tool by calling `call_discoverable_agent_tool` with\\nthe tool name and required arguments.\",\n      \"name\": \"unlock_discoverable_agent_tool\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"properties\": {\n          \"agent_tool_name\": {\n            \"description\": \"The name of the agent discoverable tool to unlock\\n(e.g., \\\"calculate_apr_adjustment_7842\\\")\",\n            \"title\": \"Agent Tool Name\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"agent_tool_name\"\n        ],\n        \"title\": \"parameters\",\n        \"type\": \"object\",\n        \"additionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"Call an agent discoverable tool that you have previously unlocked.\\n\\nUse this after unlocking a tool with `unlock_discoverable_agent_tool`. The knowledge base\\nwill tell you which tool to use and what arguments to provide.\",\n      \"name\": \"call_discoverable_agent_tool\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"properties\": {\n          \"agent_tool_name\": {\n            \"description\": \"The name of the agent discoverable tool to call\",\n            \"title\": \"Agent Tool Name\",\n            \"type\": \"string\"\n          },\n          \"arguments\": {\n            \"default\": \"{}\",\n            \"description\": \"JSON string of arguments for the tool (e.g., '{\\\"user_id\\\": \\\"abc123\\\"}')\",\n            \"title\": \"Arguments\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"agent_tool_name\",\n          \"arguments\"\n        ],\n        \"title\": \"parameters\",\n        \"type\": \"object\",\n        \"additionalProperties\": false\n      },\n      \"strict\": true\n    },\n    {\n      \"type\": \"function\",\n      \"description\": \"List all agent discoverable tools that you have called.\\n\\nUse this to see what specialized tools you have used.\",\n      \"name\": \"list_discoverable_agent_tools\",\n      \"output_schema\": null,\n      \"parameters\": {\n        \"title\": \"parameters\",\n        \"type\": \"object\"\n      },\n      \"strict\": false\n    }\n  ],\n  \"top_logprobs\": 0,\n  \"top_p\": 0.98,\n  \"truncation\": \"disabled\",\n  \"usage\": {\n    \"input_tokens\": 64758,\n    \"input_tokens_details\": {\n      \"cache_write_tokens\": 0,\n      \"cached_tokens\": 64755\n    },\n    \"output_tokens\": 220,\n    \"output_tokens_details\": {\n      \"reasoning_tokens\": 126\n    },\n    \"total_tokens\": 64978\n  },\n  \"user\": null,\n  \"metadata\": {}\n}"
